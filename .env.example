# ====================================================================
# E-Learning Course Analytics System - Environment Configuration
# Copy this file to '.env' and update with your local MySQL credentials.
# NEVER commit the actual .env file with real passwords to Git!
# ====================================================================

# MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Nani2008@
DB_NAME=elearning_db

# Flask Application Settings
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production
SECRET_KEY=elearning-analytics-secret-key-replace-in-production

# HTTPS & Cookie Security (Set to True in production with TLS)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=8

# Database Connection Pool Settings
DB_POOL_NAME=elearning_pool
DB_POOL_SIZE=5

# Production WSGI Server Settings
WAITRESS_THREADS=6

# Analytics Settings
INACTIVITY_DAYS_THRESHOLD=14
